# --- Secrets -----------------------------------------------------------------
# repo.key is the private ed25519 key that signs packages this OS trusts.
build-system/keys/

# --- Build outputs -----------------------------------------------------------
target/
tools/bin/
tools/vakt-audit
tools/vakt-ids
tools/vakt-panel
tools/zrpkg-server
vakt-verify/zig-out/
vakt-verify/.zig-cache/

# Generated package repository (rebuild with build-system/mkrepo.sh)
tools/repo/

# Compiled kernel image (rebuild with build-system/mkkernel.sh)
build-system/out/

# --- Images ------------------------------------------------------------------
# The ISO is well over GitHub's 100MB per-file limit; CI publishes it as a
# release asset instead.
*.iso
# Persistent data disk: holds Wi-Fi credentials and installed packages.
*.img

# --- Editor / OS -------------------------------------------------------------
*.swp
.DS_Store
