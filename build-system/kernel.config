# Vakt OS kernel configuration
# =============================================================================
# This is a seed, not a finished .config. build.sh feeds it to
#
#     make allnoconfig KCONFIG_ALLCONFIG=build-system/kernel.config
#
# which starts from "no" for every symbol in the tree and turns on only what is
# listed here, plus whatever those symbols depend on. That is what makes the
# result minimal: the question is never "which drivers do we remove", it is
# "which drivers did we ask for", and the answer is the file you are reading.
#
# Two consequences worth stating plainly:
#
#   * The kernel is monolithic. CONFIG_MODULES is off, so every driver below is
#     built in. There is no /lib/modules to ship, no module loader to attack,
#     and nothing for a compromised root to insert. It also takes the image from
#     hundreds of megabytes of modules and firmware down to a kernel and an
#     initramfs.
#   * The hardware list is deliberate. This targets QEMU and ordinary wired
#     x86-64 machines. A laptop with a Wi-Fi chipset needs its driver added
#     below, or the host-kernel build (VAKT_KERNEL=host), which reuses the
#     distribution kernel with its modules and firmware instead.
#
# Symbols above the OPTIONAL marker are checked after configuration, and the
# build fails if any of them did not survive - a missing storage driver is an
# unbootable image, and that should be a build error rather than a surprise in
# QEMU. Symbols below the marker are hardening preferences whose names drift
# between kernel releases; they are applied where they exist and reported where
# they do not.

# --- Platform ----------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- Syscalls the userland actually uses -------------------------------------
# vakt-init waits on a signalfd and talks to daemons over a Unix datagram
# socket; the Go tools need futex, epoll and eventfd for their scheduler.
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_MEMBARRIER=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y

# --- Boot --------------------------------------------------------------------
# GRUB loads the kernel and the gzipped cpio initramfs. There is no root= and
# no pivot: the initramfs is the root filesystem.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# --- Storage -----------------------------------------------------------------
# The persistent data disk arrives as /dev/sda. QEMU's default drive is IDE
# (ATA_PIIX), a modern machine is AHCI, and -device virtio-blk is virtio.
#
# CONFIG_BLK_DEV gates the whole drivers/block/Kconfig submenu - VIRTIO_BLK
# lives inside it. It defaults to y in the tree, but allnoconfig forces every
# default to off, so a submenu gate has to be requested explicitly here or the
# driver behind it is never even visible to be turned on.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

# --- Filesystems -------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_UNIX98_PTYS=y

# --- Console -----------------------------------------------------------------
# vakt-panel is a full-screen TUI on the system console, so the virtual
# terminal layer and a keyboard are not optional here.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
# HID_SUPPORT gates the whole drivers/hid/Kconfig submenu, same story as
# BLK_DEV above - HID, HID_GENERIC and USB_HID all live behind it.
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y

# --- Framebuffer -------------------------------------------------------------
# vakt-compositor mmaps /dev/fb0 directly. Without FB_DEVICE the framebuffer
# exists but the device node does not, and the compositor has nothing to open.
# FB_EFI depends on EFI itself (runtime service support, not just the stub),
# which is otherwise off by default under allnoconfig.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_VESA=y
CONFIG_EFI=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

# --- Networking --------------------------------------------------------------
# CONFIG_UNIX is what /run/init.sock is built on; without it no daemon can
# report readiness and nothing can ask init to shut down.
#
# NET_CORE, like BLK_DEV and HID_SUPPORT above, gates part of the driver menu
# (VIRTIO_NET lives inside it) and has to be requested explicitly.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IP_MULTICAST=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y

# --- Wireless ----------------------------------------------------------------
# The 802.11 stack wpa_supplicant drives. Chipset drivers are not built in:
# each one needs its vendor firmware, and shipping all of them is exactly the
# bloat this configuration exists to avoid. Add the one your hardware needs.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_RFKILL=y

# --- Crypto ------------------------------------------------------------------
# ext4 needs crc32c; WPA2 needs AES, CCM and CMAC.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CRC32C=y

# --- Security ----------------------------------------------------------------
# Landlock is required, not preferred. vakt-net and vakt-compositor confine
# themselves with it at startup, and a kernel without it silently downgrades
# both of them to unsandboxed - which should stop a build of a security
# appliance rather than print a warning nobody reads.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECCOMP=y
CONFIG_LSM="landlock,yama"

# =============================================================================
# OPTIONAL
# =============================================================================
# Everything past this line is applied if the kernel being built has it, and
# reported if it does not. These are the exploit mitigations, several of which
# have been renamed across releases - the Spectre options became
# CONFIG_MITIGATION_* in 6.8, so both spellings are listed and whichever one
# exists wins. A missing symbol here means "this kernel spells it differently",
# not "the build is broken". The selection follows the Kernel Self Protection
# Project's recommended settings.

# RELOCATABLE, CPU_MITIGATIONS and DEBUG_KERNEL are, again, submenu/feature
# gates that default to y in the tree but are forced off by allnoconfig:
# RANDOMIZE_BASE needs RELOCATABLE, the two MITIGATION_* symbols live inside
# "if CPU_MITIGATIONS", and SCHED_STACK_END_CHECK needs DEBUG_KERNEL.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_VMAP_STACK=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_RETPOLINE=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
